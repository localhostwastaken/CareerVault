# ── CareerVault client config ────────────────────────────────────────────────
# Copy to .env only if you need to point the app at a non-default API. Plain
# `npm run dev` works with no .env at all.
#
# Vite only exposes variables prefixed with VITE_, and inlines them at build time
# — so a production build must be rebuilt after changing these, and none of them
# may hold a secret.

# Selects which API base URL is used (see src/config/APIEndpoints.ts):
#   local       → http://localhost:9900/api/v1   (default; the local server)
#   development → whatever VITE_API_URL is set to
#   production  → /api/v1, same-origin, proxied by vercel.json to the deployed API
VITE_APP_ENV=local

# The API base URL, including the /api/v1 prefix. Read only when
# VITE_APP_ENV=development — for example when pointing at a staging API:
# VITE_API_URL=https://staging-api.example.com/api/v1
