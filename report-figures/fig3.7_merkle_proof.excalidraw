      "link": null,
      "locked": false,
      "customData": {
        "anchor": {
          "x": 0,
          "y": 420,
          "h": "left",
          "v": "top"
        }
      },
      "text": "Proof for L2 = [ L3, H(L0,L1), L4 ]  (orange): 3 sibling hashes, about ceil(log2 n).",
      "fontSize": 19.2,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Proof for L2 = [ L3, H(L0,L1), L4 ]  (orange): 3 sibling hashes, about ceil(log2 n).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XzUvAXL-YoSGRkRtGLez-",
      "type": "text",
      "x": 0,
      "y": 446,
      "width": 859.333984375,
      "height": 24,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 587875234,
      "version": 2,
      "versionNonce": 335290530,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795030841943,
      "link": null,
      "locked": false,
      "customData": {
        "anchor": {
          "x": 0,
          "y": 446,
          "h": "left",
          "v": "top"
        }
      },
      "text": "Parent = SHA-256 of the two children in sorted byte order, so no left/right flag is stored.",
      "fontSize": 19.2,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Parent = SHA-256 of the two children in sorted byte order, so no left/right flag is stored.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y7KOOuWKmcy8DKKqi6Jqg",
      "type": "text",
      "x": 0,
      "y": 472,
      "width": 796.53076171875,
      "height": 24,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 476495742,
      "version": 2,
      "versionNonce": 1372402302,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795030841943,
      "link": null,
      "locked": false,
      "customData": {
        "anchor": {
          "x": 0,
          "y": 472,
          "h": "left",
          "v": "top"
        }
      },
      "text": "An odd node is promoted unchanged; the root goes to AnchorRegistry.anchorRoot().",
      "fontSize": 19.2,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An odd node is promoted unchanged; the root goes to AnchorRegistry.anchorRoot().",
      "autoResize": true,
      "lineHeight": 1.25
    },
