      "locked": false,
      "customData": {
        "anchor": {
          "x": 0,
          "y": 420,
          "h": "left",
          "v": "top"
        }
      },
      "text": "Proof for L2 = [ L3, H(L0,L1), L4 ]  (orange): 3 sibling hashes, about ceil(log2 n).",
      "fontSize": 19.2,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Proof for L2 = [ L3, H(L0,L1), L4 ]  (orange): 3 sibling hashes, about ceil(log2 n).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ccYVXFtYttQh8n4CvL0qo",
      "type": "text",
      "x": 0,
      "y": 446,
      "width": 859.333984375,
      "height": 24,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1257940931,
      "version": 2,
      "versionNonce": 1070496579,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795118037984,
      "link": null,
      "locked": false,
      "customData": {
        "anchor": {
          "x": 0,
          "y": 446,
          "h": "left",
          "v": "top"
        }
      },
      "text": "Parent = SHA-256 of the two children in sorted byte order, so no left/right flag is stored.",
      "fontSize": 19.2,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Parent = SHA-256 of the two children in sorted byte order, so no left/right flag is stored.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VTacGEXj8-CWSRTEE6aWw",
      "type": "text",
      "x": 0,
      "y": 472,
      "width": 796.53076171875,
      "height": 24,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 1966533101,
      "version": 2,
      "versionNonce": 1188826733,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795118037984,
      "link": null,
      "locked": false,
      "customData": {
        "anchor": {
          "x": 0,
          "y": 472,
          "h": "left",
          "v": "top"
        }
      },
      "text": "An odd node is promoted unchanged; the root goes to AnchorRegistry.anchorRoot().",
      "fontSize": 19.2,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An odd node is promoted unchanged; the root goes to AnchorRegistry.anchorRoot().",
      "autoResize": true,
      "lineHeight": 1.25
    },
