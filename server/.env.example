# ── CareerVault server config ────────────────────────────────────────────────
# Copy to .env. Validated at startup (Joi, fail-fast) — a bad value stops the boot
# rather than surfacing as a strange runtime error later.
#
# For local development you only need DATABASE_URL. Everything below it has a
# working default; the values are listed so you know the knob exists.


# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL with the pgvector extension (the schema has vector(384) columns, so
# stock postgres cannot run the migrations):
#   createdb careervault
#   psql -d careervault -c "CREATE EXTENSION IF NOT EXISTS vector;"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careervault?schema=public"

# Direct (non-pooled) connection, used ONLY by the Prisma CLI for migrations.
# Needed on managed Postgres that fronts the database with a pooler — running DDL
# through PgBouncer fails. Leave unset locally; it falls back to DATABASE_URL.
# DIRECT_URL=


# ── Core ─────────────────────────────────────────────────────────────────────

NODE_ENV=development               # development | test | production
PORT=9900
CORS_ORIGIN=http://localhost:5173  # the client's origin; also the base for emailed links
WORKER=false                       # true on ONE instance only — it runs the cron jobs
DEMO_MASTER_PASSWORD_ENABLED=false # true lets "Password123@" sign into ANY account — demo only


# ── Signing keys ─────────────────────────────────────────────────────────────

# Wraps every organisation's RSA private key at rest. Generate with:
#   openssl rand -base64 32
# REQUIRED in production (the app refuses to boot without it). Left blank, each
# process invents a throwaway key, so every key it writes becomes unreadable after
# a restart and no document can be signed. Rotating it has the same effect —
# treat it as permanent.
KMS_MASTER_KEY=

# R10 fail-closed reads. true refuses any non-envelope value in an encrypted column, and
# the Merkle batch skips (never anchors) such a row, so content planted directly in the
# database without the master key is refused. false reads it back as legacy plaintext, which a
# dev database seeded before R10 still needs. Production runs true (render.yaml); check
# that `npm run db:audit-encryption` passes before turning it on.
FIELD_ENCRYPTION_STRICT=false

# RS256 keypair for access tokens. Leave blank in dev and one is generated into
# ./keys on first boot. For production, generate and paste as single-line PEM
# with newlines escaped as \n:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

JWT_ACCESS_TTL=1d                  # access-token lifetime; refresh tokens are fixed at 7 days


# ── Integration drivers ──────────────────────────────────────────────────────
# Only the values listed here are implemented — anything else throws at boot.
# In production, any driver still on its mock value logs a loud startup warning.

KEY_MANAGEMENT_DRIVER=local        # local — RSA keys as files under STORAGE_LOCAL_DIR
BLOCKCHAIN_DRIVER=local            # local (JSON-ledger simulator on disk) | amoy (Polygon, see below)
PAYMENT_DRIVER=mock                # mock  — paid features granted free, no real charges
STORAGE_DRIVER=local               # local — PDFs on disk under STORAGE_LOCAL_DIR
EMAIL_DRIVER=console               # console (logs to stdout) | gmail (real SMTP, see below)

# DNS_DRIVER=local BYPASSES domain verification: every domain "verifies", so
# documents can be issued as any organisation. It is the product's core trust
# control and must be "real" anywhere issued documents are believed.
DNS_DRIVER=local                   # local (BYPASSED) | real (checks the DNS TXT record)

# Where the local drivers keep their files: signing keys under kms/, issued PDFs
# under objects/, the anchor ledger under chain/. MUST be durable storage — on a
# container without a mounted volume these are lost on every deploy while the
# database keeps pointing at them, and signing breaks organisation-wide.
STORAGE_LOCAL_DIR=./storage


# ── Polygon anchoring — only when BLOCKCHAIN_DRIVER=amoy ──────────────────────
# Anchors each day's Merkle root in the AnchorRegistry contract instead of the local
# simulator. Under the amoy driver the first three are REQUIRED and format-checked at
# boot; with the local driver they are ignored and may stay empty.
#   POLYGON_RPC_URL          http(s) JSON-RPC endpoint for Polygon Amoy (Alchemy, Infura, …).
#                            Hosted URLs embed your provider API key — treat it as a secret.
#   ANCHOR_REGISTRY_ADDRESS  from `cd contracts && npm run deploy:amoy`
#                            (recorded in contracts/deployments/amoy.json)
#   ANCHOR_PRIVATE_KEY       0x-prefixed key of an AUTHORIZED anchor wallet funded with test
#                            POL (faucet: https://faucet.polygon.technology). Never commit
#                            it; the boot self-check logs only the wallet ADDRESS.
POLYGON_RPC_URL=
ANCHOR_REGISTRY_ADDRESS=
ANCHOR_PRIVATE_KEY=

ANCHOR_CHAIN_ID=80002              # 80002 = Polygon Amoy; the RPC must report the same id
ANCHOR_CONFIRMATIONS=2             # blocks to wait before an anchor counts as final
ANCHOR_MIN_PRIORITY_FEE_GWEI=30    # tip floor — Polygon PoS nodes reject tips under 25 gwei
ANCHOR_TX_TIMEOUT_MS=120000        # stop waiting for confirmations (the tx may still land)

# Optional. The block the registry was deployed in: `blockNumber` in
# contracts/deployments/amoy.json. A batch retry that finds its root already anchored but did
# not send it (a restart during the confirmation wait, a send that timed out after going out)
# looks up the anchoring transaction from its RootAnchored event, scanning from this block.
# Unset, it skips the lookup (never scans from block 0) and records no transaction hash; the
# offline verifier then shows ⚠ for the receipt instead of confirming it.
# ANCHOR_REGISTRY_DEPLOY_BLOCK=


# ── Gmail SMTP — only when EMAIL_DRIVER=gmail ────────────────────────────────
# Free, and needs no domain or credit card.
#   1. Enable 2FA:            https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (choose "Other (Custom name)" → "CareerVault")
#   3. Paste the 16-character password below — spaces are ignored.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=


# ── Optional ─────────────────────────────────────────────────────────────────

# The Python AI service (skill extraction and talent ranking). The whole app runs
# without it — those features degrade, nothing breaks.
AI_SERVICE_URL=http://localhost:9910
AI_SERVICE_SECRET=                 # shared secret; leave blank when running it locally

# Swagger UI at /api/docs is on automatically outside production. Set to true to
# expose it in production as well — it documents the entire API surface.
# ENABLE_SWAGGER=false


# ── Not wired up yet — kept for when the real adapters land ──────────────────
# Everything below is inert today. The driver each one belongs to throws
# "not implemented" at boot, so setting these changes nothing until that adapter
# is written. They are listed so the intended shape is not lost.

# PAYMENT_DRIVER=stripe — real billing for premium holders and paid share links.
# Both come from the Stripe dashboard; use test-mode keys (sk_test_…) until the
# flow is proven end to end.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Shared Redis, for rate-limit buckets and a real job queue (BullMQ). Rate limits
# are in-memory per process today, so they reset on restart and are not shared
# across instances.
# REDIS_URL=redis://localhost:6379

# Refresh-token lifetime. Currently fixed at 7 days in tokens.service.ts and the
# refresh cookie's maxAge; this only takes effect once both read from config.
# JWT_REFRESH_TTL=7d
