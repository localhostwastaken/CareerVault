# ── CareerVault server config ────────────────────────────────────────────────
# Copy to .env and fill in. Validated at startup by ConfigModule (Joi) — fail-fast.

# Core
NODE_ENV=development
PORT=9900
CORS_ORIGIN=http://localhost:5173
WORKER=false                       # true on the instance that runs cron/queue jobs

# Database — local PostgreSQL with the pgvector extension enabled:
#   createdb careervault && psql -d careervault -c "CREATE EXTENSION IF NOT EXISTS vector;"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careervault?schema=public"

# JWT (RS256). Generate a keypair, then PEM-encode as single-line with \n escapes.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Document signing master key — wraps per-org RSA private keys at rest (LocalKms).
# 32-byte base64 key:  openssl rand -base64 32
KMS_MASTER_KEY=

# Adapter selection — "local"/"mock"/"console" run with NO cloud deps (dev
# default); the "real" value in each pair talks to the actual provider. In
# NODE_ENV=production, any driver left on its mock value logs a LOUD boot warning
# (see src/config/env.validation.ts) — mocks in prod are allowed but never silent.
KEY_MANAGEMENT_DRIVER=local        # local (Node RSA)  | aws    (AWS KMS)
BLOCKCHAIN_DRIVER=local            # local (in-memory) | amoy   (Polygon Amoy)
PAYMENT_DRIVER=mock                # mock  (free)      | stripe (real billing)
EMAIL_DRIVER=console               # console (stdout)  | ses    (real email)
STORAGE_DRIVER=local               # local (disk)      | s3
# DNS_DRIVER=local BYPASSES domain verification (every domain "verifies" — docs
# can be signed as anyone). Use "real" for genuine DNS TXT-record checks; this is
# the core trust control and must be "real" for a trustworthy production deploy.
DNS_DRIVER=local                   # local (BYPASSED)  | real   (TXT-record check)

# Redis (used when adapters are real; dev falls back to in-memory)
REDIS_URL=redis://localhost:6379

# AI service (FastAPI)
AI_SERVICE_URL=http://localhost:9910
AI_SERVICE_SECRET=                 # shared secret; leave blank in local dev

# Blockchain (only when BLOCKCHAIN_DRIVER=amoy)
POLYGON_RPC_URL=
ANCHOR_REGISTRY_ADDRESS=
ANCHOR_PRIVATE_KEY=

# Stripe (only when PAYMENT_DRIVER=stripe — use test-mode keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local storage (when STORAGE_DRIVER=local)
STORAGE_LOCAL_DIR=./storage
